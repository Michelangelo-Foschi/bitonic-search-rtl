# Run with tclsh after sourcing Vivado's settings64.sh. No board programming.
set script_dir [file dirname [file normalize [info script]]]
source [file join $script_dir timing_common.tcl]
if {[lsearch -exact $argv -help] >= 0} {
    puts {Usage: tclsh scripts/timing_search.tcl ?-sizes {8 16 ... 1024}? ?-width 64? ?-mhz 500? ?-layout tail|distributed (default: tail)? ?-max_extra auto|N? ?-verify_min 1|0? ?-io 1|0? ?-out NEW_DIRECTORY? ?-dry_run 1?}
    exit 0
}
set cfg [bt::options [dict create -part xcv80-lsva4737-2MHP-e-S -mhz 500 \
    -sizes {8 16 32 64 128 256 512 1024} -width 64 -layout tail \
    -max_extra auto -verify_min 1 -retime 1 -uncertainty 0.1 -io_delay 0.2 \
    -margin 0.0 -threads 8 -io 1 -dry_run 0 -out {}] {*}$argv]

foreach key {-verify_min -retime -dry_run -io} {
    if {[dict get $cfg $key] ni {0 1}} {error "$key must be 0 or 1"}
}
foreach key {-mhz -uncertainty -io_delay -margin} {
    set value [dict get $cfg $key]
    if {![string is double -strict $value] || $value < 0 || ($key eq "-mhz" && $value == 0)} {error "Invalid $key"}
}
set sweep {}
foreach size [dict get $cfg -sizes] {
    if {$size > 1024} {error "This sweep supports sizes through 1024"}
    set geometry [bt::geometry $size [dict get $cfg -width] 0 [dict get $cfg -layout]]
    set max_extra [dict get $cfg -max_extra]
    if {$max_extra eq "auto"} {set max_extra [expr {max(0,[dict get $geometry levels]-1)}]}
    # Validate all inputs before starting any costly builds.
    set largest [bt::geometry $size [dict get $cfg -width] $max_extra [dict get $cfg -layout]]
    lappend sweep [list $size $max_extra]
    puts "PLAN size=$size width=[dict get $cfg -width] levels=[dict get $geometry levels] comparators=[dict get $geometry comparators] max_extra=$max_extra max_data_ff=[dict get $largest data_ff_upper_bound]"
}
if {![llength $sweep]} {error "-sizes must not be empty"}
if {[dict get $cfg -dry_run]} {exit 0}
set vivado [auto_execok vivado]
if {$vivado eq ""} {error "vivado not on PATH; source its settings64.sh, or use -dry_run 1"}
set out [dict get $cfg -out]
if {$out eq ""} {set out [file join [file dirname $script_dir] build timing [clock format [clock seconds] -format %Y%m%d-%H%M%S]]}
set out [file normalize $out]
if {[file exists $out]} {error "Refusing to overwrite existing results: $out. Choose a new -out directory."}
file mkdir $out
set fh [open [file join $out config.tcl] w]
puts $fh [list set configuration $cfg]
close $fh
set trials [open [file join $out trials.csv] w]
bt::csv $trials {size width layout extra internal tail latency target_mhz setup_slack_ns hold_slack_ns lut ff runtime_s status directory}
set summary [open [file join $out summary.csv] w]
bt::csv $summary {size width layout target_mhz best_extra latency minimum_verified trials status directory}

proc probe {size extra} {
    global cfg script_dir out trials vivado
    set run [file join $out size_$size extra_$extra]
    file mkdir $run
    set args [list -size $size -extra $extra -out $run]
    foreach key {-part -mhz -width -layout -retime -uncertainty -io_delay -margin -threads -io} {lappend args $key [dict get $cfg $key]}
    puts "BUILD size=$size extra=$extra layout=[dict get $cfg -layout] target=[dict get $cfg -mhz]MHz"
    set failed [catch {exec {*}$vivado -mode batch -notrace -nojournal -log [file join $run vivado.log] \
        -source [file join $script_dir run_candidate.tcl] -tclargs {*}$args >[file join $run console.log] 2>@1} message]
    set file [file join $run result.tcl]
    if {![file exists $file]} {error "Vivado did not produce a result: $run ($message)"}
    # result.tcl is generated by our local runner, using Tcl list quoting.
    source $file
    set row [list $size [dict get $cfg -width] [dict get $cfg -layout] $extra]
    foreach key {internal tail latency} {lappend row [expr {[dict exists $result $key] ? [dict get $result $key] : ""}]}
    lappend row [dict get $cfg -mhz]
    foreach key {setup_slack_ns hold_slack_ns lut ff runtime_s status} {
        lappend row [expr {[dict exists $result $key] ? [dict get $result $key] : ""}]
    }
    lappend row $run
    bt::csv $trials $row
    if {$failed || [dict get $result status] eq "error"} {
        error "Build error (not a timing failure): [dict get $result message]. Logs: $run"
    }
    puts "RESULT size=$size extra=$extra status=[dict get $result status] logs=$run"
    return [expr {[dict get $result status] eq "pass" ? 1 : 0}]
}

set errors 0
set no_solution 0
foreach item $sweep {
    lassign $item size max_extra
    set failed [catch {bt::search_minimum $max_extra [list probe $size] [dict get $cfg -verify_min]} found]
    if {$failed} {
        incr errors
        puts stderr "SIZE $size STOPPED: $found"
        bt::csv $summary [list $size [dict get $cfg -width] [dict get $cfg -layout] [dict get $cfg -mhz] {} {} 0 {} error [file join $out size_$size]]
        continue
    }
    set best [dict get $found best]
    set latency [expr {$best < 0 ? "" : $best+2}]
    set status [expr {$best < 0 ? "no_passing_candidate" : "pass"}]
    if {$best < 0} {incr no_solution}
    bt::csv $summary [list $size [dict get $cfg -width] [dict get $cfg -layout] [dict get $cfg -mhz] \
        $best $latency [dict get $found verified] [dict size [dict get $found tested]] $status [file join $out size_$size]]
}
close $trials
close $summary
puts "Results: [file join $out summary.csv]"
if {$errors} {exit 2}
if {$no_solution} {exit 1}
